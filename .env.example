# 接続情報のテンプレ。これを `.env` にコピーして実際の値を埋める。
# `.env` は git 管理対象外（.gitignore 済み）。

# --- PostgreSQL（ニュースデータ取得元） ---
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_NEWS_TABLE=news_all   # スキーマ込みで指定する場合は "<schema>.<table>"

# --- LLM API（OpenAI 互換エンドポイント） ---
LLM_API_TOKEN=
LLM_BASE_URL=
LLM_MODEL=gemini-3-flash-preview

# --- blpapi（ローカル Bloomberg Terminal） ---
# 通常はデフォルトの localhost:8194 で接続できるため未設定で OK
BLPAPI_HOST=localhost
BLPAPI_PORT=8194
